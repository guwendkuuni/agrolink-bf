# ============================================================
# AgroLink BF — Variables d'environnement
# Renommez ce fichier en ".env" et remplissez les valeurs
# NE JAMAIS partager ce fichier ou le mettre sur GitHub !
# ============================================================

# ── WhatsApp (Meta Developer Console) ──
WA_TOKEN=EAAxxxxxxxxxxxxxxxx          # Token d'accès WhatsApp Cloud API
WA_PHONE_ID=123456789012345           # ID du numéro WhatsApp Business
WA_VERIFY_TOKEN=agrolink_secret_2024  # Mot secret que vous choisissez

# ── Facebook (Meta Developer Console) ──
FB_PAGE_ID=123456789012345            # ID de votre page Facebook AgroLink BF
FB_PAGE_TOKEN=EAAxxxxxxxxxxxxxxxx     # Token permanent de la page

# ── Supabase (app.supabase.com > Settings > API) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhxxxxxxxx    # Clé service_role (secrète)

# ── Serveur ──
PORT=3000


# ============================================================
# GUIDE DE DÉPLOIEMENT ÉTAPE PAR ÉTAPE
# ============================================================

# ── ÉTAPE 1 : Créer le projet Supabase ──────────────────────
# 1. Allez sur https://app.supabase.com
# 2. Cliquez "New Project" → nom: "agrolink-bf"
# 3. Choisissez une région proche (Europe West)
# 4. Dashboard > SQL Editor > Collez supabase_schema.sql > Run
# 5. Copiez SUPABASE_URL et SUPABASE_SERVICE_KEY dans ce .env

# ── ÉTAPE 2 : Créer la page Facebook ────────────────────────
# 1. Créez une page "AgroLink BF" sur Facebook
# 2. Allez sur https://developers.facebook.com
# 3. Créez une app > Business
# 4. Ajoutez le produit "WhatsApp" et "Pages"
# 5. Récupérez FB_PAGE_ID et générez un token permanent

# ── ÉTAPE 3 : Configurer WhatsApp Cloud API ──────────────────
# 1. Dans votre app Meta Developer > WhatsApp > Getting Started
# 2. Ajoutez un numéro de téléphone Business
# 3. Copiez WA_TOKEN et WA_PHONE_ID
# 4. Configurez le webhook plus tard (après déploiement)

# ── ÉTAPE 4 : Déployer sur Railway ───────────────────────────
# 1. Allez sur https://railway.app
# 2. "New Project" > "Deploy from GitHub repo"
# 3. Connectez votre repo GitHub (avec les fichiers du projet)
# 4. Dans Railway > Variables : copiez toutes les variables du .env
# 5. Railway vous donne une URL publique (ex: agrolink.up.railway.app)

# ── ÉTAPE 5 : Connecter le webhook WhatsApp ──────────────────
# 1. Meta Developer > WhatsApp > Configuration
# 2. Webhook URL: https://votre-url.railway.app/webhook
# 3. Verify Token: même valeur que WA_VERIFY_TOKEN
# 4. Cliquez "Verify and Save"
# 5. Abonnez-vous à l'événement "messages"

# ── ÉTAPE 6 : Tester ─────────────────────────────────────────
# Envoyez "Bonjour" au numéro WhatsApp Business
# L'offre doit apparaître dans Supabase ET sur Facebook !

# ── COÛT MENSUEL ESTIMÉ ──────────────────────────────────────
# Railway (serveur) :     ~5 $/mois
# Supabase (base) :        0 $ (gratuit jusqu'à 500MB)
# WhatsApp Cloud API :     0 $ (1000 conversations gratuites/mois)
# Facebook Graph API :     0 $ (gratuit)
# TOTAL :                ~5 $/mois = ~3 000 FCFA/mois
